# Plantilla de configuración. Copiar a ".env" y completar con valores reales.
# Este archivo solo lleva valores de EJEMPLO: no escribir aquí datos reales.
# Ajustar la lista de variables a medida que el servicio las necesite.

# Servidor
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signalmap
# Base separada solo para los tests automatizados
DB_NAME_TEST=signalmap_test
DB_USER=signalmap_user
DB_PASSWORD=cambiar_esta_clave

# Autenticación (JWT)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Duración del token según el rol del usuario
JWT_EXPIRES_IN_ADMIN=8h
JWT_EXPIRES_IN_TECNICO=10h
JWT_EXPIRES_IN_CLIENTE=2h

# Usuarios de prueba del seed (solo desarrollo y demo; no correr el seed en un entorno real)
SEED_ADMIN_PASSWORD=cambiar_clave_admin
SEED_TECNICO_PASSWORD=cambiar_clave_tecnico
SEED_CLIENTE_PASSWORD=cambiar_clave_cliente
