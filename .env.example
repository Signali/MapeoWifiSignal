# Plantilla de configuración. Copiar a ".env" y completar con valores reales.
# Este archivo solo lleva valores de EJEMPLO: no escribir aquí datos reales.
# Ajustar la lista de variables a medida que el servicio las necesite.

# Servidor
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signalmap
# Base separada solo para los tests automatizados
DB_NAME_TEST=signalmap_test
DB_USER=signalmap_user
DB_PASSWORD=cambiar_esta_clave

# Autenticación (JWT)
# El servicio NO arranca con este valor de ejemplo (es público): generar uno propio con
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Mínimo 32 caracteres. Cada equipo tiene el suyo; no se comparte.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Duración del token según el rol del usuario: entero + s, m, h o d (máximo 30 días)
JWT_EXPIRES_IN_ADMIN=8h
JWT_EXPIRES_IN_TECNICO=10h
JWT_EXPIRES_IN_CLIENTE=2h

# Usuarios de prueba del seed (solo desarrollo y demo; no correr el seed en un entorno real)
SEED_ADMIN_PASSWORD=cambiar_clave_admin
SEED_TECNICO_PASSWORD=cambiar_clave_tecnico
SEED_CLIENTE_PASSWORD=cambiar_clave_cliente
# Nombre exacto (distingue mayúsculas) de la red WiFi de la organización: solo se guardan sus lecturas.
# En la demo, el de la red de la sala.
SEED_WIFI_SSID=SignalMap Demo

# HTTPS (opcional). Con las dos variables el servicio habla HTTPS; sin ellas, HTTP.
# Rutas relativas a la raíz del repositorio. Los archivos los crea backend/scripts/tls-certs.sh
# (carpeta certs/, fuera de git). Si defines una, define la otra.
TLS_CERT_FILE=
TLS_KEY_FILE=
