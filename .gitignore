# Secretos y configuración local: NUNCA se suben (usar .env.example como plantilla)
.env
.env.*
!.env.example
*.pem
*.key

# Configuración local de Claude Code (personal de cada equipo)
.claude/settings.local.json

# Dependencias y builds (se regeneran)
node_modules/
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Environment de Postman con la clave real (la plantilla .example.json sí se sube)
postman/*.postman_environment.json

# Postman (configuracion local de la app)
.postman/
postman/globals/

# Android (local.properties, cachés de Gradle y Kotlin, APK)
android/local.properties
android/.gradle/
android/.kotlin/
*.apk

# Certificados y claves de HTTPS local (los genera backend/scripts/tls-certs.sh)
certs/
